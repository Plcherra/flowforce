  "legacyAliases": {
    "administrator": "admin",
    "company_admin": "admin",
    "employee": "staff",
    "supervisor": "manager"
  },
  "routePermissionMap": [
    {
      "surface": "Role administration",
      "routes": [
        "/settings/permissions",
        "/sections-permissions",
        "/admin/users"
      ],
      "requiredAny": ["admin.roles", "admin.permissions", "manageUsers"]
    },
    {
      "surface": "Company settings",
      "routes": ["/settings", "/admin/settings"],
      "requiredAny": ["admin.settings", "systemSettings"]
    },
    {
      "surface": "Manager scheduling actions",
      "routes": ["/scheduling", "/shift-management"],
      "requiredAny": ["editSchedules", "schedule.edit", "approveTimeOff"]
    },
    {
      "surface": "Inventory management",
      "routes": ["/inventory", "/inventory/actions", "/inventory/counts"],
      "requiredAny": ["inventory.edit", "inventory.adjust", "manageInventory"]
    },
    {
      "surface": "Billing and payments",
      "routes": ["/billing", "/settings/billing"],
      "requiredAny": ["billing.view", "managePayments"]
    }
  ]
}
