{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/availability/layout,_N_T_/app/availability/page,_N_T_/app/availability"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/availability/__PAGE__",
    "/app/availability",
    "/app",
    "/_index",
    "/_head"
  ]
}