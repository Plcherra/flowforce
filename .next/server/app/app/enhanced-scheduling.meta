{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/enhanced-scheduling/layout,_N_T_/app/enhanced-scheduling/page,_N_T_/app/enhanced-scheduling"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/enhanced-scheduling/__PAGE__",
    "/app/enhanced-scheduling",
    "/app",
    "/_index",
    "/_head"
  ]
}