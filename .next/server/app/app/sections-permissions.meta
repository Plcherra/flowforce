{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/sections-permissions/layout,_N_T_/app/sections-permissions/page,_N_T_/app/sections-permissions"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/sections-permissions/__PAGE__",
    "/app/sections-permissions",
    "/app",
    "/_index",
    "/_head"
  ]
}