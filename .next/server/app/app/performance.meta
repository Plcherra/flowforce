{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/performance/layout,_N_T_/app/performance/page,_N_T_/app/performance"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/performance/__PAGE__",
    "/app/performance",
    "/app",
    "/_index",
    "/_head"
  ]
}