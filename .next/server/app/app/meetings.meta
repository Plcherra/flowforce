{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/meetings/layout,_N_T_/app/meetings/page,_N_T_/app/meetings"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/meetings/__PAGE__",
    "/app/meetings",
    "/app",
    "/_index",
    "/_head"
  ]
}