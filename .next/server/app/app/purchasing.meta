{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/purchasing/layout,_N_T_/app/purchasing/page,_N_T_/app/purchasing"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/purchasing/__PAGE__",
    "/app/purchasing",
    "/app",
    "/_index",
    "/_head"
  ]
}