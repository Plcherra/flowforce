{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/events/layout,_N_T_/app/events/calendar/layout,_N_T_/app/events/calendar/page,_N_T_/app/events/calendar"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/events/calendar/__PAGE__",
    "/app/events/calendar",
    "/app/events",
    "/app",
    "/_index",
    "/_head"
  ]
}