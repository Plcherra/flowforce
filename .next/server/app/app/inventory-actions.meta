{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/inventory-actions/layout,_N_T_/app/inventory-actions/page,_N_T_/app/inventory-actions"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/inventory-actions/__PAGE__",
    "/app/inventory-actions",
    "/app",
    "/_index",
    "/_head"
  ]
}