{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/forms/layout,_N_T_/app/forms/page,_N_T_/app/forms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/forms/__PAGE__",
    "/app/forms",
    "/app",
    "/_index",
    "/_head"
  ]
}