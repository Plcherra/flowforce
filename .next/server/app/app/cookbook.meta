{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/cookbook/layout,_N_T_/app/cookbook/page,_N_T_/app/cookbook"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/cookbook/__PAGE__",
    "/app/cookbook",
    "/app",
    "/_index",
    "/_head"
  ]
}