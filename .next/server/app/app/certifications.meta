{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/certifications/layout,_N_T_/app/certifications/page,_N_T_/app/certifications"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/certifications/__PAGE__",
    "/app/certifications",
    "/app",
    "/_index",
    "/_head"
  ]
}