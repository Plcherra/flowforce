{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/expenses/layout,_N_T_/app/expenses/page,_N_T_/app/expenses"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/expenses/__PAGE__",
    "/app/expenses",
    "/app",
    "/_index",
    "/_head"
  ]
}