{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "tests",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "supabase",
    "reports",
    "dev",
    "dist"
  ]
}
