{
  "version": 2,
  "rewrites": [
    {
      "source": "/app(/.*)?",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/ops/run-detectors",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/ops/run-dev-detectors",
      "schedule": "30 */4 * * *"
    }
  ]
}
