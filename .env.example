# FlowForce environment template
#
# Copy this file to `.env.local` for local development.
# Never commit real keys or database passwords.

# Required: browser/client Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required: server-only Supabase admin operations
# Used by API routes, cron jobs, onboarding completion, and backend scripts.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: server-only Supabase URL alias for scripts/Edge functions.
# If omitted, server code falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional: AI features and Supabase Edge Functions that call OpenAI.
OPENAI_API_KEY=your_openai_api_key

# Optional: cron route protection.
CRON_SECRET=your_cron_secret

# Optional: external integrations.
CONNECTEAM_API_KEY=your_connecteam_api_key
NEXT_PUBLIC_CONNECTEAM_API_BASE=https://api.connecteam.com/v1

# Optional: logging configuration.
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_REMOTE_LOG_LEVEL=warn
NEXT_PUBLIC_ENABLE_REMOTE_LOGS=true
NEXT_PUBLIC_REMOTE_LOG_ENDPOINT=/api/logs
LOG_INGEST_TOKEN=your_log_ingest_token
LOG_LEVEL=info
LOG_PERSIST_LEVEL=warn
LOG_PERSISTENCE=true

# Optional: operations/demo defaults.
NEXT_PUBLIC_DEFAULT_COMPANY_ID=
NEXT_PUBLIC_FLOWFORCE_AUTOMATIONS_ENDPOINT=

# Optional: local validation scripts.
TEST_URL=http://localhost:3000
SMOKE_TIMEOUT_MS=15000
KPI_RANGE_DAYS=14
