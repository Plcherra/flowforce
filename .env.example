# FlowForce environment template
#
# Copy this file to `.env.local` for local development.
# Never commit real keys or database passwords.

# -----------------------------------------------------------------------------
# Public browser env
# -----------------------------------------------------------------------------
# Required in production. These values are compiled into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_REMOTE_LOG_LEVEL=warn
NEXT_PUBLIC_ENABLE_REMOTE_LOGS=true
NEXT_PUBLIC_REMOTE_LOG_ENDPOINT=/api/logs
NEXT_PUBLIC_ENABLE_AI_INSIGHTS=false
  NEXT_PUBLIC_DEFAULT_COMPANY_ID=
NEXT_PUBLIC_FLOWFORCE_AUTOMATIONS_ENDPOINT=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# -----------------------------------------------------------------------------
# Server-only env
# -----------------------------------------------------------------------------
# Required for API routes, cron jobs, onboarding completion, backend scripts,
# and Supabase Edge Functions. Never expose these as NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: AI features and Supabase Edge Functions that call OpenAI.
OPENAI_API_KEY=your_openai_api_key

# Optional: cron route protection.
CRON_SECRET=your_cron_secret

# Optional: server logging configuration.
LOG_INGEST_TOKEN=your_log_ingest_token
LOG_LEVEL=info
LOG_PERSIST_LEVEL=warn
LOG_PERSISTENCE=true

# Optional: internal support/admin route protection.
# Generate a long random value and store the real value only in local/deploy secrets.
SUPPORT_ADMIN_TOKEN=your_long_random_support_admin_token

# Optional: Stripe billing (required for paid checkout and webhooks).
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_PRICE_STARTER=price_starter_test_id
STRIPE_PRICE_GROWTH=price_growth_test_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_test_id

# Optional: days to keep workspace active after invoice.payment_failed (default 7).
BILLING_PAYMENT_GRACE_DAYS=7

# -----------------------------------------------------------------------------
# Test and smoke env
# -----------------------------------------------------------------------------
TEST_URL=http://127.0.0.1:3000
ONBOARDING_E2E_BASE_URL=http://127.0.0.1:3000
SMOKE_TIMEOUT_MS=15000
SMOKE_HEADED=0
SMOKE_KEEP_DATA=0
KPI_RANGE_DAYS=14

# -----------------------------------------------------------------------------
# Deploy and CI env
# -----------------------------------------------------------------------------
# GitHub Actions stores secret values as repository secrets.
SUPABASE_DB_PASSWORD=your_remote_database_password
# Personal access token from https://supabase.com/dashboard/account/tokens (sbp_...)
# NOT the anon key or service role key.
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
SUPABASE_PROJECT_REF=vncapxfubgqaibhjwtoy
SUPABASE_CLI_BIN=supabase
SUPABASE_CLI_VERSION=2.101.0
